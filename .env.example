# 复制为 .env 后按需修改。页面「设置」中的配置优先于本文件。
# 注意：.env 在 server.js 启动最早期加载，改完必须重启服务才生效。

# LLM API Key（推荐使用智谱 GLM，也可换成任何 OpenAI 兼容服务）
INTERVIEW_MATE_API_KEY=

# OpenAI 兼容的 Base URL（不带 /chat/completions）
INTERVIEW_MATE_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称
INTERVIEW_MATE_MODEL=glm-4-flash

# 服务监听地址与端口
# HOST=127.0.0.1 仅本机可访问（默认，带 DNS rebinding 防护）
# HOST=0.0.0.0   允许局域网访问（此时不再强制 Host 校验）
HOST=127.0.0.1
PORT=3000

# 可写数据目录：jobs-store / briefs / 上传文件都在这里
# 默认是仓库下的 data/；改成绝对路径可把用户数据挪出仓库（升级/重装不丢）
# INTERVIEW_MATE_DATA_DIR=D:/interview-mate-data

# 流式代理超时（毫秒）
# 首字节超时：上游多久没反应算不可用（默认 30000）
INTERVIEW_MATE_UPSTREAM_FIRST_BYTE_MS=30000
# 空闲超时：开始吐字后，多久没有新数据算卡死（默认 120000；整场面试不设总时长）
INTERVIEW_MATE_UPSTREAM_IDLE_MS=120000

# 岗位雷达自动抓取间隔（分钟），0 = 关闭自动抓取（仍可手动刷新）
INTERVIEW_MATE_JOB_REFRESH_MIN=30

# 每日简报调度器检查间隔（分钟，默认 720=12 小时）。需要服务端 Key；
# 未配置服务端 Key 时，页面打开会用页面 Key 现场生成（或本地兜底版）。
INTERVIEW_MATE_BRIEF_CHECK_MIN=720
