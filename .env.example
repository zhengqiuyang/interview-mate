# 复制为 .env 后按需修改。页面「设置」中的配置优先于本文件。

# LLM API Key（推荐使用智谱 GLM，也可换成任何 OpenAI 兼容服务）
INTERVIEW_MATE_API_KEY=

# OpenAI 兼容的 Base URL（不带 /chat/completions）
INTERVIEW_MATE_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称
INTERVIEW_MATE_MODEL=glm-4-flash

# 服务监听端口
PORT=3000

# 岗位雷达自动抓取间隔（分钟），0 = 关闭自动抓取（仍可手动刷新）
INTERVIEW_MATE_JOB_REFRESH_MIN=30

# 每日简报调度器检查间隔（分钟，默认 720=12 小时）。需要服务端 Key；
# 未配置服务端 Key 时，页面打开会用页面 Key 现场生成（或本地兜底版）。
INTERVIEW_MATE_BRIEF_CHECK_MIN=720
